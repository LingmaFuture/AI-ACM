# Public URL and application secrets
SITE_ADDRESS=:80
FRONTEND_URL=http://localhost
SECRET_KEY=replace-with-a-long-random-string
ENVIRONMENT=production
COOKIE_SECURE=false

# PostgreSQL
POSTGRES_DB=aiacm
POSTGRES_USER=aiacm
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://aiacm:replace-with-a-strong-database-password@db:5432/aiacm

# Redis / Celery
REDIS_URL=redis://redis:6379/0
SYNC_TASKS=false

# Private object storage
STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=aiacm
S3_SECRET_KEY=replace-with-a-strong-storage-password
S3_BUCKET=aiacm-private

# OpenAI-compatible provider. Leave AI_API_KEY empty to use the local demo generator.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini

# smtp://user:password@mail.example.com:587 or smtps://...
SMTP_URL=

# Judge worker
JUDGE_MODE=docker
JUDGE_IMAGE=aiacm-runner:latest
JUDGE_TOTAL_TIMEOUT_SECONDS=20

